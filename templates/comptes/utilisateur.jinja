{% extends "base.jinja" %}

{% block titre %}Mon compte{% endblock %}

{% block contenu %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-5">
        <div>
            <h2 class="text-white fw-bold mb-2">
                <i class="fa-solid fa-user-circle text-info me-2"></i> Mon compte
            </h2>
            <p class="text-white-50 mb-0">Gérez vos informations et vos réservations.</p>
        </div>
        <a href="{{ url_for('compte.deconnexion') }}" class="btn btn-primary rounded-pill">
            <i class="fa-solid fa-right-from-bracket me-2"></i>
            Se déconnecter
        </a>
    </div>

    {% with messages = get_flashed_messages(with_categories=true) %}
    {% for categorie, message in messages %}
    <div
        class="alert alert-{{ 'success' if categorie == 'success' else 'danger' }} alert-dismissible fade show rounded-3">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endfor %}
    {% endwith %}

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card bg-dark text-white border-info border-opacity-25 rounded-4 shadow h-100">

                <div class="card-header bg-dark text-info border-info border-opacity-25 p-3 rounded-top-4">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-id-card me-2"></i>
                        Mes informations
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <div
                            class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex align-items-center justify-content-center p-4">
                            <i class="fa-solid fa-user fa-2x"></i>
                        </div>

                        <h4 class="fw-bold mt-3 mb-1">
                            {{ utilisateur.prenom }} {{ utilisateur.nom }}
                        </h4>
                    </div>

                    <hr class="border-info border-opacity-25">

                    <div class="mb-3">
                        <small class="text-white-50 fw-bold">NOM</small>
                        <p class="fw-semibold mb-0 mt-1">
                            <i class="fa-solid fa-user text-info me-2"></i>
                            {{ utilisateur.nom }}
                        </p>
                    </div>

                    <div class="mb-3">
                        <small class="text-white-50 fw-bold">PRÉNOM</small>
                        <p class="fw-semibold mb-0 mt-1">
                            <i class="fa-solid fa-user text-info me-2"></i>
                            {{ utilisateur.prenom }}
                        </p>
                    </div>

                    <div class="mb-4">
                        <small class="text-white-50 fw-bold">COURRIEL</small>
                        <p class="fw-semibold mb-0 mt-1 text-break">
                            <i class="fa-regular fa-envelope text-info me-2"></i>
                            {{ utilisateur.email }}
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card bg-dark text-white border-info border-opacity-25 rounded-4 shadow h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                            <i class="fa-solid fa-bed fa-lg"></i>
                        </div>
                        <h5 class="text-info fw-bold mb-0">Mes réservations</h5>
                    </div>

                    {% if reservations %}
                    <div class="d-flex flex-column gap-3">
                        {% for r in reservations %}
                        <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3">
                            <div class="card-body p-3">
                                <div class="row align-items-center g-3">
                                    <div class="col-md-7">
                                        <h5 class="fw-bold mb-2">{{ r.type_chambre }}</h5>
                                        <p class="text-white-50 small mb-2">
                                            <i class="fa-regular fa-calendar text-info me-2"></i>
                                            Du {{ r.date_arrivee }} au {{ r.date_depart }}
                                        </p>
                                        <span class="text-info fw-bold fs-5">{{ r.prix_nuit }} $</span>
                                        <small class="text-white-50">par nuit</small>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="d-flex flex-column gap-2">
                                            <form method="POST"
                                                action="{{ url_for('reservations.annuler', id_reservation=r.id) }}"
                                                class="m-0">
                                                <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100">
                                                    <i class="fa-solid fa-xmark me-1"></i>
                                                    Annuler
                                                </button>
                                            </form>

                                            <a href="{{ url_for('reservations.page_modifier_reservation', id_reservation=r.id) }}"
                                                class="btn btn-success btn-sm rounded-pill w-100">
                                                <i class="fa-solid fa-pen me-1"></i>
                                                Modifier
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="text-center py-5">
                        <i class="fa-solid fa-calendar-xmark fa-3x text-secondary mb-3"></i>
                        <p class="text-white-50 mb-0">Aucune réservation pour le moment.</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card bg-dark text-white border-info border-opacity-25 rounded-4 shadow">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                            <i class="fa-solid fa-receipt fa-lg"></i>
                        </div>
                        <h5 class="text-info fw-bold mb-0">Facture</h5>
                    </div>

                    {% for r in reservations %}
                    <div class="bg-secondary bg-opacity-10 rounded-3 p-4 mb-3">
                        <h6 class="fw-bold mb-1">{{ r.type_chambre }}</h6>
                        <small class="text-white-50">Du {{ r.date_arrivee }} au {{ r.date_depart }}</small>
                        <hr class="border-secondary">

                        <div class="d-flex justify-content-between small mt-2">
                            <span>{{ r.nb_nuits }} nuit(s) x {{ r.prix_nuit }} $</span>
                            <span>{{ r.total_sejour }} $</span>
                        </div>

                        {% for p in r.repas %}
                        <div class="d-flex justify-content-between small mt-2">
                            <span>{{ p.quantite }} x {{ p.nom }}</span>
                            <span>{{ p.total }} $</span>
                        </div>
                        {% endfor %}

                        <hr class="border-secondary">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Sous-total</span>
                            <span>{{ r.total }} $</span>
                        </div>
                    </div>
                    {% else %}
                    <p class="text-white-50">Aucune réservation à facturer.</p>
                    {% endfor %}

                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                            <div class="bg-secondary bg-opacity-10 rounded-3 p-4 h-100">
                                <small class="text-white-50">Réservations</small>
                                <h4 class="fw-bold mt-2 mb-0">{{ total_reservations }} $</h4>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="bg-secondary bg-opacity-10 rounded-3 p-4 h-100">
                                <small class="text-white-50">Repas</small>
                                <h4 class="fw-bold mt-2 mb-0">{{ total_repas }} $</h4>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="bg-info bg-opacity-10 border border-info rounded-3 p-4 h-100">
                                <small class="text-info">Total</small>
                                <h4 class="fw-bold text-info mt-2 mb-0">{{ total_general }} $</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}