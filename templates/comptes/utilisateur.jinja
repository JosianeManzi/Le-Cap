{% extends "base.jinja" %}

{% block titre %}Mon compte{% endblock %}

{% block contenu %}
<div class="container mt-5 mb-5">

  <h2 class="fw-normal mb-4">Mon compte</h2>

  <div class="row g-4">

    <div class="col-md-4">
      <div class="border rounded p-4 h-100">
        <h5 class="fw-normal mb-3">Informations</h5>
        <p class="mb-1"><strong>Nom :</strong> {{ utilisateur.nom }}</p>
        <p class="mb-1"><strong>Prénom :</strong> {{ utilisateur.prenom }}</p>
        <p class="mb-0"><strong>Courriel :</strong> {{ utilisateur.email }}</p>
      </div>
    </div>

  </div>

  <h5 class="fw-normal mt-5 mb-3">Mes réservations</h5>
  <p class="mb-0"><strong>Aucune réservation</strong></p>


  <a href="{{ url_for('compte.deconnexion') }}" class="btn btn-outline-danger">Déconnexion</a>

</div>
{% endblock %}