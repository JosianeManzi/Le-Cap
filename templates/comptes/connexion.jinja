{% extends "base.jinja" %}

{% block titre %}Connexion - Le-Cap{% endblock %}

{% block contenu %}
<div class="page-connexion container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="fw-bold mb-2">Connexion</h1>
                        <p class="text-muted">Accédez à votre compte Le-Cap</p>
                    </div>

                    <form id="form-connexion">
                        <div class="mb-3">
                            <label for="courriel" class="form-label fw-semibold">Courriel</label>
                            <input class="form-control form-control-lg" id="courriel" name="courriel">
                            <div id="erreur-courriel" class="text-danger small"></div>
                        </div>

                        <div class="mb-4">
                            <label for="mot_de_passe" class="form-label fw-semibold">Mot de passe</label>
                            <input type="password" class="form-control form-control-lg" id="mot_de_passe" name="mot_de_passe">
                            <div id="erreur-motdepasse" class="text-danger small"></div>
                        </div>

                        <div id="erreur-connexion" class="text-danger small mb-3"></div>

                        <div class="d-flex justify-content-center">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3" style="width: 200px;">
                                Se connecter
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script defer="defer" src="/static/js/utils-ajax.js"></script>
<script defer="defer" src="/static/js/connexion.js"></script>
{% endblock %}