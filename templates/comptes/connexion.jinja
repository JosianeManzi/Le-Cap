{% extends "base.jinja" %}

{% block titre %}Connexion - Le-Cap{% endblock %}

{% block contenu %}

<div class="page-connexion container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="fw-bold mb-2">Connexion</h1>
                        <p class="text-muted">Connectez-vous à votre compte Le-Cap</p>
                    </div>
                    <form id="form-connexion"  method="POST"  action="{{ url_for('compte.connexion') }}">
                        <div class="mb-3">
                            <label for="courriel" class="form-label fw-semibold">Courriel</label>
                            <input type="email" class="form-control form-control-lg" id="courriel" name="courriel"
                                placeholder="exemple@courriel.com">
                            <div id="erreur-courriel" class="text-danger small"></div>
                        </div>

                        <div class="mb-4">
                            <label for="mot_de_passe" class="form-label fw-semibold"> Mot de passe </label>
                            <input type="password" class="form-control form-control-lg" id="mot_de_passe"
                                name="mot_de_passe" placeholder="Entrez votre mot de passe">
                            <div id="erreur-motdepasse" class="text-danger small"></div>
                        </div>
                        {% with messages = get_flashed_messages() %}
                        {% if messages %}
                        <div class="messages-flash mb-3">
                            {% for message in messages %}
                            <p class="text-danger">{{ message }}</p>
                            {% endfor %}
                        </div>
                        {% endif %}
                        {% endwith %}
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3"> Connexion
                            </button>
                            <a href="{{ url_for('compte.page_creer_compte')}}" class="btn btn-primary btn-lg rounded-3">
                                Créer un compte </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script defer="defer" src="/static/js/utils-ajax.js"></script>
<script defer="defer" src="/static/js/compte.js"></script>
{% endblock %}