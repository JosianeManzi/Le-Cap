{% extends "base.jinja" %}

{% block titre %}Créer un compte - Le-Cap{% endblock %}

{% block contenu %}

<div class="page-inscription container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h1 class="fw-bold mb-2">Créer un compte</h1>
                        <p class="text-muted"> Rejoignez Le-Cap dès maintenant </p>
                    </div>

                    <form id="form-creer-compte" >
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="nom" class="form-label fw-semibold">Nom</label>
                                <input type="text" class="form-control form-control-lg" id="nom" name="nom"
                                    placeholder="Votre nom">
                                <div id="erreur-nom" class="text-danger small"></div>

                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="prenom" class="form-label fw-semibold"> Prénom </label>
                                <input type="text" class="form-control form-control-lg" id="prenom" name="prenom"
                                    placeholder="Votre prénom">
                                <div id="erreur-prenom" class="text-danger small"></div>

                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="courriel" class="form-label fw-semibold">Courriel</label>
                            <input class="form-control form-control-lg" id="courriel" name="courriel"
                                placeholder="exemple@courriel.com">
                            <div id="erreur-courriel" class="text-danger small"></div>

                        </div>

                        <div class="mb-3">
                            <label for="mot_de_passe" class="form-label fw-semibold"> Mot de passe</label>
                            <input type="password" class="form-control form-control-lg" id="mot_de_passe"
                                name="mot_de_passe" placeholder="Entrez votre mot de passe">
                            <div id="erreur-motdepasse" class="text-danger small"></div>

                        </div>

                        <div class="mb-4">
                            <label for="confirmation_mot_de_passe" class="form-label fw-semibold">Confirmer le mot de
                                passe</label>
                            <input type="password" class="form-control form-control-lg" id="confirmation_mot_de_passe"
                                name="confirmation_mot_de_passe" placeholder="Confirmez votre mot de passe">
                            <div id="erreur-confirmation" class="text-danger small"></div>

                        </div>
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3" style="width: 200px;">
                                Créer compte
                            </button>

                            <a href="{{ url_for('compte.page_connexion') }}" class="btn btn-primary btn-lg rounded-3" style="width: 200px;">
                                Connexion
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script defer="defer" src="/static/js/utils-ajax.js"></script>
<script defer="defer" src="/static/js/compte.js"></script>
{% endblock %}