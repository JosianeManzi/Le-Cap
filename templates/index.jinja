{% extends "base.jinja" %}

{% block titre %}Accueil{% endblock %}

{% block contenu %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<div id="hotelCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-pause="false" data-bs-interval="4000">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="{{ url_for('static', filename='img/interior1.jpg') }}" class="d-block w-100"
                alt="Intérieur de l'hôtel">

            <div class="carousel-caption d-flex flex-column justify-content-center h-100">
                <p class="text-uppercase fw-semibold">Bienvenue chez</p>
                <h1 class="display-4 fw-bold">Hôtel Le Cap</h1>
                <p>Une expérience exceptionnelle</p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="{{ url_for('static', filename='img/interior2.jpg') }}" class="d-block w-100"
                alt="Chambre élégante">

            <div class="carousel-caption d-flex flex-column justify-content-center h-100">
                <p class="text-uppercase fw-semibold">Confort & élégance</p>
                <h1 class="display-4 fw-bold">Le luxe à votre portée</h1>
                <p class="fs-4">Un séjour inoubliable vous attend</p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="{{ url_for('static', filename='img/interior3.jpg') }}" class="d-block w-100" alt="Hôtel de luxe">

            <div class="carousel-caption d-flex flex-column justify-content-center h-100">
                <p class="text-uppercase fw-semibold">Votre prochaine escapade</p>
                <h1 class="display-4 fw-bold">Vivez l'exceptionnel</h1>
                <p class="fs-4">Là où chaque instant devient précieux</p>
            </div>
        </div>

    </div>
</div>
<section class="container text-white py-5" id="chambres">
    <div class="text-center mb-5">
        <p class="text-uppercase small">Hôtel Le Cap</p>
        <h2 class="display-5 fw-light"> Nos chambres</h2>
        <p class="text-secondary">Trois univers pour un séjour inoubliable.</p>
    </div>
    <div class="row align-items-center g-4 mb-5">
        <div class="col-md-7">
            <img src="{{ url_for('static', filename='img/standard2.jpg') }}" class="img-fluid w-100 rounded-2 shadow"
                alt="Chambre simple">
        </div>

        <div class="col-md-5 p-md-4">
            <p class="small text-uppercase">01 — Simplicité</p>
            <h3 class="display-6 fw-light">Chambre classique</h3>
            <p class="text-secondary lh-lg">Un espace confortable et accueillant, où simplicité et élégance se
                rencontrent pour vous offrir un séjour reposant.
            </p>
        </div>
    </div>

    <div class="row align-items-center g-4 mb-5">
        <div class="col-md-7 order-md-2">
            <img src="{{ url_for('static', filename='img/suite3.jpg') }}" class="img-fluid w-100 rounded-2 shadow"
                alt="Chambre moderne">
        </div>

        <div class="col-md-5 order-md-1 p-md-4">
            <p class="small text-uppercase">02 — Modernité</p>
            <h3 class="display-6">Chambre moderne </h3>
            <p class="text-secondary lh-lg">Un design contemporain avec une ambiance lumineuse pour
                profiter d’un confort actuel et raffiné.
            </p>
        </div>
    </div>

    <div class="row align-items-center g-4">
        <div class="col-md-7">
            <img src="{{ url_for('static', filename='img/luxueux3.jpg') }}" class="img-fluid w-100 rounded-2 shadow"
                alt="Chambre luxueuse">
        </div>

        <div class="col-md-5 p-md-4">
            <p class="small text-uppercase">03 — Prestige </p>
            <h3 class="display-6">Chambre luxueuse</h3>
            <p class="text-secondary lh-lg">Un cadre spacieux et sophistiqué, pensé pour une expérience exclusive où
                chaque détail invite à la détente.</p>
        </div>
    </div>

</section>

<section id="services" class="services-section text-white py-5">
    <div class="container">
        <div class="text-center mb-5">
            <p class="services-eyebrow text-uppercase mb-2">Pour votre bien-être</p>
            <h2 class="services-title display-6 fw-bold mb-3">NOS SERVICES</h2>
            <p class="text-secondary">Profitez de chaque instant grâce à nos espaces dédiés à la détente.</p>
        </div>

        <div class="row g-4 pb-md-5">

            <div class="col-6 col-lg-3 service-col">
                <div class="service-card">
                    <img src="{{ url_for('static', filename='img/spa.jpg') }}" alt="Espace spa et détente">
                    <div class="service-caption">
                        <h5 class="fw-bold mb-1">Spa et détente</h5>
                        <p class="mb-0 small">Offrez-vous un moment de relaxation et de bien-être.</p>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3 service-col">
                <div class="service-card">
                    <img src="{{ url_for('static', filename='img/gym.jpg') }}" alt="Salle de sport moderne">
                    <div class="service-caption">
                        <h5 class="fw-bold mb-1">Salle de sport</h5>
                        <p class="mb-0 small">Gardez la forme grâce à nos équipements modernes.</p>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3 service-col">
                <div class="service-card">
                    <img src="{{ url_for('static', filename='img/bar.jpg') }}" alt="Restaurant de l'établissement">
                    <div class="service-caption">
                        <h5 class="fw-bold mb-1">Restaurant</h5>
                        <p class="mb-0 small">Savourez des plats délicieux dans un cadre agréable.</p>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3 service-col">
                <div class="service-card">
                    <img src="{{ url_for('static', filename='img/piscine.jpg') }}" alt="Piscine de l'établissement">
                    <div class="service-caption">
                        <h5 class="fw-bold mb-1">Piscine</h5>
                        <p class="mb-0 small">Profitez d'un instant de fraîcheur et de tranquillité.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

{% endblock %}