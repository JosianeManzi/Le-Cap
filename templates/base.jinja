<!DOCTYPE html>
<html lang="fr">

<head>
    <title>{% block titre %}Accueil{% endblock %} | Le-Cap</title>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="#">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
</head>

<body>
    <nav class="navbar navbar-expand-lg bg-white py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand fs-2 fw-normal text-dark" href="#"> Le-Cap </a>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto gap-lg-5">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#"> Accueil</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">Chambres</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">Services</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#"> Nous joindre</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#"> Connexion</a>
                    </li>

                </ul>

                <a href="#" class="btn btn-dark rounded-0 px-4 py-3">Réserver maintenant </a>
            </div>
        </div>
    </nav>


    <main>
        {% block contenu %}
        {% endblock %}
    </main>


    <footer class="bg-white border-top mt-auto">
        <div class="container py-5">
            <div class="row text-center text-md-start">
                <div class="col-md-6 mb-4 mb-md-0">
                    <h5 class="fw-normal mb-3">CONTACT</h5>
                    <p class="mb-1">Téléphone : 418-000-0000</p>
                    <p class="mb-0">courriel@le-cap.ca</p>
                </div>
                <div class="col-md-6">
                    <h5 class="fw-normal mb-3">ADRESSE</h5>

                    <p class="mb-1">123 Rue du Cap</p>
                    <p class="mb-0">Québec, QC</p>
                </div>
            </div>
        </div>
    </footer>
</body>

</html>