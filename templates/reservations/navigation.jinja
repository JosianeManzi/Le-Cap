{% extends "base.jinja" %}

{% block titre %}Réserver - Le-Cap{% endblock %}

{% block contenu %}

<div class="container py-5">
    <form class="search-bar shadow-dark rounded-4 p-3 p-lg-4 mx-auto" method="post"
        action="{{ url_for('reservations.liste') }}">
        <div class="row g-3 align-items-center justify-content-center">

            <div class="col-12 col-lg-auto">
                <div class="pill d-flex flex-column flex-sm-row align-items-sm-center gap-2 px-3 py-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="date-placeholder">Arrivée</span>
                        <input type="date" name="arrivee" value="{{ arrivee }}" class="form-control">
                    </div>
                    <span class="date-placeholder d-none d-sm-inline">→</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="date-placeholder">Départ</span>
                        <input type="date" name="depart" value="{{ depart }}" class="form-control">
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-auto">
                <div class="pill d-flex align-items-center justify-content-center gap-2 px-3 py-2">
                    <span class="date-placeholder">👤</span>
                    <input type="number" name="clients" value="{{ clients }}" min="1" max="4"
                        class="form-control text-center" style="min-width: 70px;">
                    <span>Clients</span>
                </div>
            </div>

            <div class="col-6 col-lg-auto">
                <div class="pill d-flex align-items-center px-3 py-2">
                    <select name="type_chambre"class="form-select bg-dark form-control select-type">
                        <option value="">Tous les types</option>
                        <option value="Simple">Simple</option>
                        <option value="Suite">Suite</option>
                        <option value="Luxueux">Luxueux</option>
                    </select>
                </div>
            </div>

            <div class="col-12 col-lg-auto">
                <button type="submit" class="btn btn-search rounded-pill px-4 py-3 w-100">Rechercher</button>
            </div>

        </div>
    </form>

    {% with messages = get_flashed_messages(with_categories=true) %}
    {% for categorie, message in messages %}
    <div class="text-danger text-center mt-4">{{ message }}</div>
    {% endfor %}
    {% endwith %}
</div>

{% endblock %}