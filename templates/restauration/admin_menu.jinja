{% extends "base.jinja" %}

{% block titre %}Gestion du menu{% endblock %}

{% block contenu %}
<div class="page-inscription container">

    <div class="mb-5 text-center">
        <h1 class="fw-bold">Gestion du menu</h1>
        <p class="text-muted">Ajoutez un plat ou retirez-le du menu proposé aux clients.</p>
    </div>

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% for niveau, message in messages %}
        <div class="alert alert-{{ niveau }}">{{ message }}</div>
        {% endfor %}
    {% endwith %}

    <div class="card border-0 shadow-lg rounded-4 mb-5">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">Ajouter un plat</h4>

            <form method="post" action="{{ url_for('restauration.ajouter_plat_menu') }}">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label for="nom" class="form-label">Nom du plat</label>
                        <input type="text" class="form-control" id="nom" name="nom" maxlength="100" required>
                    </div>

                    <div class="col-6 col-md-3">
                        <label for="prix" class="form-label">Prix ($)</label>
                        <input type="number" class="form-control" id="prix" name="prix" step="0.01" min="0.01" max="500" required>
                    </div>

                    <div class="col-6 col-md-3">
                        <label for="categorie" class="form-label">Repas</label>
                        <select class="form-select" id="categorie" name="categorie" required>
                            {% for cle, titre, icone in categories %}
                            <option value="{{ cle }}">{{ titre }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-12">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="description" rows="2" required></textarea>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary rounded-3 px-5">Ajouter au menu</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% for cle, titre, icone in categories %}
    <div class="card border-0 shadow-lg rounded-4 mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">{{ titre }}</h4>

            {% for plat in plats_par_categorie[cle] %}
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-3 {% if not loop.last %}border-bottom{% endif %}">
                <div>
                    <span class="fw-semibold">{{ plat.nom }}</span>
                    <span class="text-muted ms-2">{{ '%.2f'|format(plat.prix) }} $</span>
                    {% if plat.disponible %}
                    <span class="badge bg-success ms-2">Au menu</span>
                    {% else %}
                    <span class="badge bg-secondary ms-2">Retiré</span>
                    {% endif %}
                </div>

                <form method="post" action="{{ url_for('restauration.basculer_plat', id_plat=plat.id) }}">
                    {% if plat.disponible %}
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-3">Retirer du menu</button>
                    {% else %}
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-3">Remettre au menu</button>
                    {% endif %}
                </form>
            </div>
            {% else %}
            <p class="text-muted mb-0">Aucun plat dans cette catégorie.</p>
            {% endfor %}
        </div>
    </div>
    {% endfor %}

</div>
{% endblock %}

{% block scripts %}
{% endblock %}