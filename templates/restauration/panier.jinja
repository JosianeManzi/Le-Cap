{% extends "base.jinja" %}

{% block titre %}Mon panier{% endblock %}

{% block contenu %}
<div class="page-inscription container">

    <h1 class="fw-bold text-center mb-5">Mon panier</h1>

    {% if lignes %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4">

                    {% for ligne in lignes %}
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 py-3 {% if not loop.last %}border-bottom{% endif %}">

                        <div>
                            <h5 class="fw-bold mb-1">{{ ligne.plat.nom }}</h5>
                            <span class="text-muted">{{ '%.2f'|format(ligne.plat.prix) }} $ l'unité</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <form method="post" action="{{ url_for('restauration.modifier_panier', id_plat=ligne.plat.id) }}">
                                <input type="hidden" name="action" value="moins">
                                <button type="submit" class="btn btn-outline-primary btn-sm px-3">−</button>
                            </form>

                            <span class="fw-semibold px-2">{{ ligne.quantite }}</span>

                            <form method="post" action="{{ url_for('restauration.modifier_panier', id_plat=ligne.plat.id) }}">
                                <input type="hidden" name="action" value="plus">
                                <button type="submit" class="btn btn-outline-primary btn-sm px-3">+</button>
                            </form>

                            <span class="fw-semibold ms-3 text-end" style="min-width: 80px;">{{ '%.2f'|format(ligne.sous_total) }} $</span>

                            <form method="post" action="{{ url_for('restauration.modifier_panier', id_plat=ligne.plat.id) }}">
                                <input type="hidden" name="action" value="retirer">
                                <button type="submit" class="btn btn-outline-danger btn-sm ms-2">Retirer</button>
                            </form>
                        </div>

                    </div>
                    {% endfor %}

                    <div class="d-flex justify-content-between pt-4">
                        <h4 class="fw-bold">Total</h4>
                        <h4 class="fw-bold">{{ '%.2f'|format(total) }} $</h4>
                    </div>

                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between gap-3 mt-4">
                <a href="{{ url_for('restauration.page_menu') }}" class="btn btn-outline-primary rounded-3">Continuer mes achats</a>
                <a href="#" class="btn btn-primary rounded-3 px-5">Commander</a>
            </div>

        </div>
    </div>

    {% else %}
    <div class="text-center">
        <p class="text-muted mb-4">Votre panier est vide.</p>
        <a href="{{ url_for('restauration.page_menu') }}" class="btn btn-primary rounded-3 px-5">Voir le menu</a>
    </div>
    {% endif %}

</div>
{% endblock %}

{% block scripts %}
{% endblock %}