{% extends "base.jinja" %}

{% block titre %}Nous joindre{% endblock %}

{% block contenu %}
<div class="container py-5">

    <div class="mb-5 text-center">
        <h1 class="fw-bold text-white">Nous joindre</h1>
        <p class="text-white-50">Une question ou une demande ? Contactez-nous.</p>
    </div>

    <div class="row g-4 justify-content-center">

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 h-100 text-center">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Téléphone</h4>
                    <p class="text-muted mb-0">418-000-0000</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 h-100 text-center">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Courriel</h4>
                    <p class="text-muted mb-0">courriel@le-cap.ca</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 h-100 text-center">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Adresse</h4>
                    <p class="text-muted mb-0">123 Rue du Cap<br>Québec, QC</p>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block scripts %}
{% endblock %}