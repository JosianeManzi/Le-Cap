{% extends "base.jinja" %}

{% block titre %}Nous joindre{% endblock %}

{% block contenu %}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-white">Nous joindre</h1>
        <p class="text-white-50">Une question ou une demande ? Notre équipe est là pour vous aider. </p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card bg-dark text-white border-info border-opacity-25 rounded-4 shadow h-100 text-center">
                <div class="card-body p-4">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                        style="width: 85px; height: 85px; font-size: 38px;">
                        ☎
                    </div>
                    <h4 class="fw-bold text-info">Téléphone</h4>
                    <p class="text-white-50 mb-3">Appelez-nous pour toute question.</p>
                    <p class="text-white fw-semibold text-decoration-none"> 418-000-0000 </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card bg-dark text-white border-info border-opacity-25 rounded-4 shadow h-100 text-center">
                <div class="card-body p-4">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                        style="width: 85px; height: 85px; font-size: 38px;">
                        ✉
                    </div>
                    <h4 class="fw-bold text-info">Courriel</h4>
                    <p class="text-white-50 mb-3"> Écrivez-nous, nous vous répondrons rapidement. </p>
                    <p class="text-white fw-semibold text-decoration-none text-break"> courriel@le-cap.ca </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card bg-dark text-white border-info border-opacity-25 rounded-4 shadow h-100 text-center">
                <div class="card-body p-4">

                    <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                        style="width: 85px; height: 85px; font-size: 38px;">
                        📍
                    </div>
                    <h4 class="fw-bold text-info">Adresse</h4>
                    <p class="text-white-50 mb-3"> Venez nous rendre visite ! </p>
                    <p class="text-white fw-semibold mb-0">123 Rue du Cap<br> Québec, QC </p>
                </div>
            </div>
        </div>

    </div>
</div>

{% endblock %}

{% block scripts %}
{% endblock %}