{% extends "base.jinja" %}

{% block titre %}Espace Administrateur - Le-Cap{% endblock %}

{% block contenu %}
<div class="container py-5">

    <div class="mb-5 text-center">
        <h1 class="fw-bold">Espace Administrateur</h1>
        <p class="text-muted">Gérez les chambres, les réservations et les clients du Le-Cap</p>
    </div>

    <div class="row g-4 justify-content-center">

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 h-100 text-center">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3">🛏️</div>
                    <h4 class="fw-bold">Chambres</h4>
                    <p class="text-muted">Consulter et ajouter des chambres</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="#" class="btn btn-outline-primary rounded-3">Voir la liste</a>
                        <a href="#" class="btn btn-primary rounded-3">Ajouter une chambre</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 h-100 text-center">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3">📋</div>
                    <h4 class="fw-bold">Réservations</h4>
                    <p class="text-muted">Suivre les réservations en cours</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="#" class="btn btn-outline-primary rounded-3">Voir les réservations</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 h-100 text-center">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3">👥</div>
                    <h4 class="fw-bold">Clients</h4>
                    <p class="text-muted">Consulter la liste des clients</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="#" class="btn btn-outline-primary rounded-3">Voir les clients</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block scripts %}
{% endblock %}