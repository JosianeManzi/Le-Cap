{% extends "base.jinja" %}

{% block titre %}Gestion des chambres{% endblock %}

{% block contenu %}
<div class="page-inscription container">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-5">
        <h1 class="fw-bold mb-0">Gestion des chambres</h1>
        <a href="{{ url_for('compte.page_utilisateur') }}" class="btn btn-outline-primary rounded-3">Retour</a>
    </div>

    {% for niveau, message in get_flashed_messages(with_categories=true) %}
    <div class="alert alert-{{ niveau }}">{{ message }}</div>
    {% endfor %}

    <div class="row g-4">
        {% for chambre in chambres %}
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 h-100 overflow-hidden">

                {% if chambre.image %}
                <img src="{{ url_for('static', filename='img/' ~ chambre.image) }}"
                     alt="{{ chambre.type_chambre }}" class="card-img-top"
                     style="height: 200px; object-fit: cover;">
                {% endif %}

                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h4 class="fw-bold mb-0">{{ chambre.type_chambre }}</h4>
                        {% if chambre.disponible %}
                        <span class="badge bg-success">Disponible</span>
                        {% else %}
                        <span class="badge bg-secondary">Indisponible</span>
                        {% endif %}
                    </div>

                    <p class="text-muted flex-grow-1">{{ chambre.description }}</p>
                    <p class="fw-semibold mb-1">{{ chambre.prix_nuit }} $ / nuit</p>
                    <p class="mb-3">👥 {{ chambre.nb_personnes }} personne{{ 's' if chambre.nb_personnes > 1 }}</p>

                    <div class="d-grid gap-2">
                        <a href="{{ url_for('chambres.page_modifier_chambre', id_chambre=chambre.id) }}"
                           class="btn btn-primary rounded-3">Modifier</a>

                                              <form method="post" action="{{ url_for('chambres.basculer_chambre_admin', id_chambre=chambre.id) }}" novalidate>
                            {% if chambre.disponible %}
                            <button type="submit" class="btn btn-outline-danger rounded-3 w-100">Retirer de la liste</button>
                            {% else %}
                            <button type="submit" class="btn btn-outline-primary rounded-3 w-100">Remettre dans la liste</button>
                            {% endif %}
                        </form>
                    </div>
                </div>

            </div>
        </div>
        {% else %}
        <p class="text-center text-muted">Aucune chambre pour le moment.</p>
        {% endfor %}
    </div>

</div>
{% endblock %}

{% block scripts %}
{% endblock %}